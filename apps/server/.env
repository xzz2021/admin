#  本地开发时使用,最终线上读取的变量是项目根目录的env文件

PG_DATABASE_URL="postgresql://root:xzz...@localhost:5432/testcasl"

PORT=3000
TOKEN_SECRET=xzz2021
TOKEN_REFRESH_SECRET=xzz2022
TOKEN_EXPIRES_TIME=300
TOKEN_REFRESH_EXPIRES_TIME=259200

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=xzz...
REDIS_URL=redis://localhost:6379

SSO_COUNT=3
SWAGGER=true
# 仅当 SWAGGER=true 时配置；密码至少 6 位且不得使用占位值
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=123456
STATIC_FILE_ROOT_PATH=public
STATIC_FILE_SERVE_ROOT=api/public


HELMET=true

# 首次初始化数据库需要
SEED_ADMIN_USERNAME=xzz2021
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_PHONE=13011112222


LOG_FILE=true


# 文件管理大文件上传（均可选，以下为默认值）
FILE_UPLOAD_MAX_BYTES=524288000
FILE_UPLOAD_CHUNK_BYTES=5242880
FILE_UPLOAD_SESSION_TTL_HOURS=24
FILE_UPLOAD_MAX_OPEN_SESSIONS=5
