# Server
NODE_ENV=production
PORT=3000
TOKEN_SECRET=replace-with-at-least-32-random-characters
TOKEN_REFRESH_SECRET=replace-with-another-32-random-characters
TOKEN_EXPIRES_TIME=300
TOKEN_REFRESH_EXPIRES_TIME=259200
SSO_COUNT=3
SWAGGER=false
# 仅当 SWAGGER=true 时配置；密码至少 16 位且不得使用占位值
# SWAGGER_USERNAME=docs-admin
# SWAGGER_PASSWORD=replace-with-a-strong-random-password
HELMET=true
# 本地文件日志（warn+，按小时滚动）。容器内默认关闭，调试时再开
LOG_FILE=false
STATIC_FILE_ROOT_PATH=public
STATIC_FILE_SERVE_ROOT=api/public
# 文件管理大文件上传（均可选，以下为默认值）
# FILE_UPLOAD_MAX_BYTES=524288000
# FILE_UPLOAD_CHUNK_BYTES=5242880
# FILE_UPLOAD_SESSION_TTL_HOURS=24
# FILE_UPLOAD_MAX_OPEN_SESSIONS=5

# OSS / S3 兼容存储（可选。四项都配齐才启用；缺一则 /oss/* 返回 503）
# OSS_S3_ENDPOINT=http://127.0.0.1:9000
# OSS_S3_REGION=us-east-1
# OSS_S3_ACCESS_KEY=
# OSS_S3_SECRET_KEY=
# OSS_S3_BUCKET=
# OSS_S3_FORCE_PATH_STYLE=true
# OSS_PUT_SIMPLE_MAX_BYTES=16777216
# OSS_MULTIPART_PART_BYTES=8388608
# OSS_PRESIGN_GET_EXPIRES_SEC=3600
# OSS_PRESIGN_PUT_EXPIRES_SEC=900
# OSS_MAX_BATCH_KEYS=1000

# 数据库备份功能
DB_BACKUP_DIR=/app/apps/server/backups
DB_BACKUP_CRON=0 0 * * * *
DB_BACKUP_TIMEZONE=Asia/Shanghai
DB_BACKUP_RETENTION_MAX=24
DB_BACKUP_PREFIX=backstage_db
DB_BACKUP_GZIP=true

# 首次初始化管理员（仅空数据库 Seed 使用）
SEED_ADMIN_USERNAME=replace-with-admin-username
SEED_ADMIN_PASSWORD=replace-with-at-least-6-random-characters
SEED_ADMIN_PHONE=replace-with-valid-phone-number

# PostgreSQL：管理、迁移、运行账户必须使用不同密码
POSTGRES_DB=app
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-random-admin-password
POSTGRES_MIGRATOR_USER=app_migrator
POSTGRES_MIGRATOR_PASSWORD=replace-with-random-migrator-password
POSTGRES_APP_USER=app_runtime
POSTGRES_APP_PASSWORD=replace-with-random-runtime-password
PG_DATABASE_URL=postgresql://app_migrator:URL_ENCODED_PASSWORD@postgres:5432/app
APP_DATABASE_URL=postgresql://app_runtime:URL_ENCODED_PASSWORD@postgres:5432/app

# Redis（compose 服务名 redis）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-random-redis-password
